DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app
CORS_ORIGINS=http://localhost:3000
# At least 32 characters. A new value ends all sessions: docs/backend/AUTH.md#session-token.
SESSION_SECRET=
# Safari and local HTTP builds can reject a Secure cookie: set false locally if the session is not kept after user creation.
COOKIE_SECURE=true
# OpenAI: phones (DESCRIPTION_MODEL, GUARDRAIL_MODEL) and rag (EMBEDDING_MODEL, SEARCH_MODEL, RERANK_MODEL, GUARDRAIL_MODEL) modules, shared key: docs/backend/DESIGN.md#configuration.
OPENAI_API_KEY=
DESCRIPTION_MODEL=gpt-5.6-luna
GUARDRAIL_MODEL=gpt-5.6-luna
EMBEDDING_MODEL=text-embedding-3-small
SEARCH_MODEL=gpt-5.6-luna
RERANK_MODEL=gpt-5.6-luna
RERANK_THRESHOLD=0.3
# LangSmith tracing, optional: docs/ai/EVALUATION.md#tracing. `make eval` needs LANGSMITH_API_KEY whatever LANGSMITH_TRACING is.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=second-hand-mobile-e-market
# Empty: the LangSmith default. EU region: https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=
