#!/usr/bin/env python3
"""pre-commit gate for the artifact harness.

Blocks a commit when the ACTIVE task is in a state that must not be committed:
  - stage == ESCALATED           (loop exhausted / broken)
  - open_issues non-empty        (failed validation still pending)
  - stage == DONE                (must close first: `runner.py done`)
WIP commits mid-task (INIT/PLANNED/APPROVED/EXECUTED/VALIDATED, clean) pass.

Then runs the tests of both applications on every commit:
  - backend  -> `make backend-test` (ruff + pytest, OpenAI and LangSmith are stubbed)
  - frontend -> `pnpm lint`, `pnpm typecheck`, `pnpm test`
The LLM evaluation (`make eval`) is never run here: it makes real OpenAI calls.
Install once: `python3 .claude/runner.py install-hooks`.
"""
import os, subprocess, sys

ROOT = os.getcwd()  # git runs hooks from the repo root
ACTIVE = os.path.join(ROOT, ".claude", "tasks", "ACTIVE")

def field(text, key):
    for line in text.splitlines():
        s = line.strip()
        if s.startswith(key + ":"):
            return s.split(":",1)[1].split("#")[0].strip()
    return None

def block(msg):
    print(f"✖ commit blocked: {msg}", file=sys.stderr)
    sys.exit(1)

def check_task():
    if not os.path.isfile(ACTIVE):
        return
    tid = open(ACTIVE).read().strip()
    if not tid:
        return  # no active task -> nothing to guard
    import glob
    hits = glob.glob(os.path.join(ROOT, ".claude", "tasks", "CURRENT", tid, "STATE.yaml"))
    if not hits:
        return  # active id not among open tasks (already archived) -> nothing to guard
    sp = hits[0]
    s = open(sp, encoding="utf-8").read()
    stage = field(s, "stage")
    oi = field(s, "open_issues")

    if stage == "ESCALATED":
        block(f"active task '{tid}' is ESCALATED. Resolve it (Engineer) before committing.")
    if oi not in (None, "[]", ""):
        block(f"active task '{tid}' has unresolved open_issues {oi}. "
              f"Route them through the pipeline first.")
    if stage == "DONE":
        block(f"active task '{tid}' is DONE. Close it with "
              f"`python3 .claude/runner.py done` to clear the active task, then commit.")

TESTS = [
    ["make", "backend-test"],
    ["pnpm", "--dir", "frontend", "lint"],
    ["pnpm", "--dir", "frontend", "typecheck"],
    ["pnpm", "--dir", "frontend", "test"],
]

def run_tests():
    for cmd in TESTS:
        print(f"pre-commit: {' '.join(cmd)}", file=sys.stderr)
        if subprocess.run(cmd, cwd=ROOT).returncode != 0:
            block(f"`{' '.join(cmd)}` failed. Fix the tests before committing.")

def main():
    check_task()
    run_tests()
    sys.exit(0)

if __name__ == "__main__":
    main()
